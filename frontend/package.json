{
  "name": "observability-city-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "test": "vitest run",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "e2e": "playwright test && npm run e2e:links && npm run e2e:tenants && npm run e2e:dashboard && npm run e2e:ui && npm run e2e:direct && npm run e2e:live && npm run e2e:sources && npm run e2e:discovery && npm run e2e:scope && npm run e2e:health && npm run e2e:functions && npm run e2e:messaging && npm run e2e:towns && npm run e2e:wide",
    "e2e:scenarios": "playwright test",
    "e2e:links": "node scripts/e2e.mjs links --",
    "e2e:ui": "node scripts/e2e.mjs ui --",
    "e2e:direct": "node scripts/e2e.mjs direct --",
    "e2e:live": "node scripts/e2e.mjs live --",
    "e2e:sources": "node scripts/e2e.mjs sources --",
    "e2e:discovery": "node scripts/e2e.mjs discovery --",
    "e2e:scope": "node scripts/e2e.mjs scope scopeb --",
    "e2e:health": "node scripts/e2e.mjs health healthb --",
    "e2e:functions": "node scripts/e2e.mjs functions functionsb --",
    "e2e:tenants": "node scripts/e2e.mjs tenants --",
    "e2e:dashboard": "node scripts/e2e.mjs dashboard --",
    "e2e:wide": "node scripts/e2e.mjs wide --",
    "e2e:messaging": "node scripts/e2e.mjs messaging messagingb routes --",
    "e2e:towns": "node scripts/e2e.mjs towns --",
    "e2e:themes": "node scripts/e2e.mjs towns E2E_ALL_THEMES=1 -- themes.spec.ts --",
    "e2e:slow": "npm run e2e:stress && npm run e2e:stress35 && npm run e2e:town && npm run e2e:themes",
    "e2e:stress": "node scripts/e2e.mjs stress --",
    "e2e:stress35": "node scripts/e2e.mjs stress35 --",
    "e2e:town": "node scripts/e2e.mjs town --",
    "check:contracts": "node scripts/gen-contracts.mjs --check"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
