<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Clear the sources inherited from the machine or user NuGet config: with central package management, NuGet warns (NU1507) whenever
         more than one source is defined and none is mapped. Everything this repo needs is on nuget.org. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
