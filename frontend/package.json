{
  "name": "observability-city-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "test": "vitest run",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "e2e": "playwright test && npm run e2e:links && npm run e2e:tenants && npm run e2e:ui && npm run e2e:direct && npm run e2e:live",
    "e2e:links": "cross-env E2E_SUITE=links playwright test",
    "e2e:ui": "cross-env E2E_SUITE=ui playwright test",
    "e2e:direct": "cross-env E2E_SUITE=direct playwright test",
    "e2e:live": "cross-env E2E_SUITE=live playwright test",
    "e2e:tenants": "cross-env E2E_SUITE=tenants playwright test",
    "e2e:slow": "npm run e2e:stress && npm run e2e:stress35 && npm run e2e:town",
    "e2e:stress": "cross-env E2E_SUITE=stress playwright test",
    "e2e:stress35": "cross-env E2E_SUITE=stress35 playwright test",
    "e2e:town": "cross-env E2E_SUITE=town playwright test",
    "check:contracts": "node scripts/gen-contracts.mjs --check"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
