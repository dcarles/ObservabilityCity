{
  "name": "observability-city-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "test": "vitest run",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "e2e": "playwright test",
    "e2e:slow": "npm run e2e:stress && npm run e2e:town",
    "e2e:stress": "cross-env E2E_SUITE=stress playwright test",
    "e2e:town": "cross-env E2E_SUITE=town playwright test",
    "check:contracts": "node scripts/gen-contracts.mjs --check"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "cross-env": "^7.0.3",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
